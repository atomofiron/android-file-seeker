<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/padding_semi"
    android:paddingStart="@dimen/padding_common"
    android:paddingHorizontal="@dimen/padding_large"
    >
    <ImageView
        android:id="@+id/status_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/params"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/padding_half"
        android:layout_marginStart="@dimen/padding_semi"
        android:textColor="?attr/colorContent"
        android:ellipsize="end"
        android:singleLine="true"
        tools:text="[ ] [ ] query"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/status_icon"
        app:layout_constraintBottom_toTopOf="@+id/status_text"
        />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/padding_semi"
        android:textColor="?attr/colorContent"
        tools:text="[ ] 144 [ ]36 [ ]96 charset"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/status_icon"
        app:layout_constraintTop_toBottomOf="@+id/params"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <ImageView
        android:id="@+id/uncached"
        android:layout_width="@dimen/icon_size_mini"
        android:layout_height="@dimen/icon_size_mini"
        android:src="@drawable/ic_save_off"
        android:layout_marginEnd="@dimen/padding_half"
        app:tint="?attr/colorAccent"
        app:layout_constraintTop_toTopOf="@+id/action"
        app:layout_constraintEnd_toStartOf="@+id/action"
        app:layout_constraintBottom_toBottomOf="@+id/action"
        />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stop"
        android:paddingHorizontal="@dimen/padding_common"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        style="?materialTonalButton"
        />
</androidx.constraintlayout.widget.ConstraintLayout>