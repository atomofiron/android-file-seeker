<?xml version="1.0" encoding="utf-8"?>
<app.atomofiron.searchboxapp.custom.view.layout.RootCoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?colorBackground"
    >
    <app.atomofiron.searchboxapp.custom.view.HeaderLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dense_toolbar"
            app:navigationIcon="@drawable/ic_back"
            tools:title="Title"
            />
        <LinearLayout
            android:id="@+id/path_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_ripple_16"
            android:contentDescription="@string/copy"
            >
            <ImageView
                android:layout_width="56dp"
                android:layout_height="@dimen/icon_button_size"
                android:paddingVertical="@dimen/padding_semi"
                android:src="@drawable/ic_copy"
                android:contentDescription="@string/copy"
                android:tint="?colorContent"
                />
            <TextView
                android:id="@+id/path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/padding_mini"
                android:layout_gravity="center_vertical"
                tools:text="/sdcard/fadb/file.txt"
                />
        </LinearLayout>
    </app.atomofiron.searchboxapp.custom.view.HeaderLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/content_margin_half"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior"
        />
    <app.atomofiron.searchboxapp.custom.view.SnackbarContainerLayout
        android:id="@+id/snackbar_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        />
    <app.atomofiron.searchboxapp.custom.view.dock.DockBarView
        android:id="@+id/dock_bar"
        android:layout_width="@dimen/dock_width"
        android:layout_height="@dimen/dock_height"
        />
</app.atomofiron.searchboxapp.custom.view.layout.RootCoordinatorLayout>